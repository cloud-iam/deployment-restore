# Optional: copy this file to `keycloak.env` and add any extra env vars
# you want passed to the Keycloak container (KC_*, provider-specific vars, etc).
# Anything declared here overrides the defaults set in docker-compose.yml.
#
# Examples:
#
# KC_LOG_LEVEL=DEBUG
# KC_FEATURES=preview,token-exchange
# KC_HTTP_RELATIVE_PATH=/auth
# MY_PROVIDER_SECRET=...
